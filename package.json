{
  "name": "dsh-obsidian",
  "version": "0.1.0",
  "description": "Self-organizing AI second brain for Obsidian, as a single DeepSeek Harness plugin. Merged fork of dsh-plugin-wiki-skills + dsh-plugin-wiki-tools, targeting parity with claude-obsidian.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test test/",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "obsidian",
    "knowledge-base",
    "second-brain",
    "llm-wiki"
  ],
  "dsh": {
    "kind": "plugin",
    "provides": ["tools", "skills"]
  }
}
